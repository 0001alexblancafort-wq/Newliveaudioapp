<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="CIPIC Player"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpatialAudioApp">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SpatialAudioApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".MusicFXService"
            android:exported="true"
            android:label="Spatial 3D Engine">
            <intent-filter>
                <action android:name="android.media.audiofx.MusicFX" />
            </intent-filter>
            <meta-data
                android:name="android.media.audiofx.MusicFX"
                android:resource="@xml/musicfx_definition" />
        </service>
    </application>
</manifest>
